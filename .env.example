# Optional HTTP basic auth for preview deployments.
# Uncomment both lines if you want local Vercel dev to require basic auth.
# BASIC_AUTH_USER=beatlab
# BASIC_AUTH_PASSWORD=

# AI command bar + Beat Coach Q&A.
# Keep real keys in .env, .env.local, or Vercel project env vars.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternative Gemini names supported by the serverless provider wrapper.
# LLM_PROVIDER=gemini
# GOOGLE_GENERATIVE_AI_API_KEY=
# AI_MODEL=gemini-2.5-flash

# OpenAI or OpenAI-compatible providers.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible services can override the base URL and key name.
# AI_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
