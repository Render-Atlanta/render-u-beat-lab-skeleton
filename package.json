{
  "name": "render-u-beat-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run hygiene && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "hygiene": "tsx scripts/check-module-hygiene.ts",
    "check": "npm run hygiene && npm run typecheck:scripts && npm test",
    "smoke:ai": "tsx scripts/smoke-ai.ts",
    "analyze:reference": "tsx scripts/analyze-reference.ts",
    "generate:kit": "tsx scripts/generate-kit.ts",
    "generate:style-profiles": "tsx scripts/generate-style-profiles.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "meyda": "^5.6.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tone": "^15.1.22",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4"
  }
}
